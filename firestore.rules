rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Spielstände: nur der eigene Account darf lesen und schreiben.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Arena-Champions: alle Angemeldeten dürfen lesen.
    // Nur der Besitzer darf seinen Champion anlegen/ändern – Wertung, Siege, Niederlagen und Log
    // kann ausschließlich der Server (Cloud Functions) verändern.
    match /arena/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.rating == 1000
        && request.resource.data.w == 0 && request.resource.data.l == 0
        && request.resource.data.log.size() == 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'sc', 'ci', 'icon', 'cn', 'snap', 'power', 'ts', 'v']);
      allow delete: if false;
    }

    // Kämpfe und Tageslimits schreibt nur der Server.
    match /matches/{id} {
      allow read: if request.auth != null && resource.data.attacker == request.auth.uid;
      allow write: if false;
    }
    match /limits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
